{
  "manifest_version": 3,
  "name": "Tab Group Reloader",
  "version": "1.0.1",
  "description": "Reload all tabs in one Chrome tab group from a simple toolbar popup.",
  "permissions": [
    "tabGroups"
  ],
  "action": {
    "default_title": "Tab Group Reloader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
